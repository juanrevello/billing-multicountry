{
  "openapi": "3.1.0",
  "info": {
    "title": "Billing Multi-Country",
    "description": "Issues invoices through a per-country provider, with idempotency (Idempotency-Key), retries and a full audit trail of every provider call.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/providers": {
      "get": {
        "tags": [
          "providers"
        ],
        "summary": "List Providers",
        "operationId": "list_providers_providers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProviderOut"
                  },
                  "type": "array",
                  "title": "Response List Providers Providers Get"
                }
              }
            }
          }
        }
      }
    },
    "/invoices": {
      "post": {
        "tags": [
          "invoices"
        ],
        "summary": "Issue Invoice",
        "operationId": "issue_invoice_invoices_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "UUID that identifies this invoice request",
              "title": "Idempotency-Key"
            },
            "description": "UUID that identifies this invoice request"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invoice issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceOut"
                }
              }
            }
          },
          "200": {
            "description": "Replay of an invoice already issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceOut"
                }
              }
            }
          },
          "202": {
            "description": "Provider timed out; outcome unknown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceOut"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency-Key reused with another body, or a concurrent request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input, unsupported country/currency or provider rejection",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Provider unavailable after retries",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{invoice_id}": {
      "get": {
        "tags": [
          "invoices"
        ],
        "summary": "Get Invoice",
        "operationId": "get_invoice_invoices__invoice_id__get",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Invoice Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice with its full audit trail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceDetailOut"
                }
              }
            }
          },
          "404": {
            "description": "Invoice not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Invalid invoice_id",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttemptKind": {
        "type": "string",
        "enum": [
          "issue",
          "lookup"
        ],
        "title": "AttemptKind"
      },
      "AttemptOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "attempt_number": {
            "type": "integer",
            "title": "Attempt Number"
          },
          "kind": {
            "$ref": "#/components/schemas/AttemptKind"
          },
          "outcome": {
            "$ref": "#/components/schemas/AttemptOutcome"
          },
          "request_payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Request Payload"
          },
          "response_status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Status"
          },
          "response_body": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Body"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "id",
          "attempt_number",
          "kind",
          "outcome",
          "request_payload",
          "response_status",
          "response_body",
          "error",
          "started_at",
          "finished_at",
          "duration_ms"
        ],
        "title": "AttemptOut"
      },
      "AttemptOutcome": {
        "type": "string",
        "enum": [
          "in_flight",
          "success",
          "retryable_error",
          "rejected",
          "timeout",
          "not_found"
        ],
        "title": "AttemptOutcome"
      },
      "InvoiceDetailOut": {
        "properties": {
          "invoice_id": {
            "type": "string",
            "format": "uuid",
            "title": "Invoice Id"
          },
          "status": {
            "$ref": "#/components/schemas/InvoiceStatus"
          },
          "provider_used": {
            "type": "string",
            "title": "Provider Used"
          },
          "external_reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Reference"
          },
          "entity_id": {
            "type": "string",
            "title": "Entity Id"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "country_code": {
            "type": "string",
            "title": "Country Code"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Detail"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "attempts": {
            "items": {
              "$ref": "#/components/schemas/AttemptOut"
            },
            "type": "array",
            "title": "Attempts"
          }
        },
        "type": "object",
        "required": [
          "invoice_id",
          "status",
          "provider_used",
          "external_reference",
          "entity_id",
          "amount",
          "currency",
          "country_code",
          "error_code",
          "error_detail",
          "created_at",
          "updated_at",
          "attempts"
        ],
        "title": "InvoiceDetailOut"
      },
      "InvoiceIn": {
        "properties": {
          "entity_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Entity Id",
            "examples": [
              "20-12345678-9"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "100.50"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "examples": [
              "ARS"
            ]
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Country Code",
            "examples": [
              "AR"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "entity_id",
          "amount",
          "currency",
          "country_code"
        ],
        "title": "InvoiceIn"
      },
      "InvoiceOut": {
        "properties": {
          "invoice_id": {
            "type": "string",
            "format": "uuid",
            "title": "Invoice Id"
          },
          "status": {
            "$ref": "#/components/schemas/InvoiceStatus"
          },
          "provider_used": {
            "type": "string",
            "title": "Provider Used"
          },
          "external_reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Reference"
          },
          "entity_id": {
            "type": "string",
            "title": "Entity Id"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "country_code": {
            "type": "string",
            "title": "Country Code"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Detail"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "invoice_id",
          "status",
          "provider_used",
          "external_reference",
          "entity_id",
          "amount",
          "currency",
          "country_code",
          "error_code",
          "error_detail",
          "created_at",
          "updated_at"
        ],
        "title": "InvoiceOut"
      },
      "InvoiceStatus": {
        "type": "string",
        "enum": [
          "pending",
          "issued",
          "failed"
        ],
        "title": "InvoiceStatus"
      },
      "ProviderOut": {
        "properties": {
          "country_code": {
            "type": "string",
            "title": "Country Code"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "currencies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Currencies"
          }
        },
        "type": "object",
        "required": [
          "country_code",
          "provider",
          "currencies"
        ],
        "title": "ProviderOut"
      },
      "ProblemDetails": {
        "description": "RFC 9457 body; the optional fields are extensions present only when they apply.",
        "properties": {
          "type": {
            "title": "Type",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "invoice_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Invoice Id"
          },
          "invoice_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Invoice Status"
          },
          "supported_currencies": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Supported Currencies"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "ProblemDetails",
        "type": "object"
      }
    }
  }
}
