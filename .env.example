# App
APP_NAME=billing-multicountry
ENVIRONMENT=local
LOG_LEVEL=DEBUG

# Database
DATABASE_URL=postgresql+asyncpg://test_user:test_user_password@localhost:5432/invoicing

# Provider defaults (apply to every country); the base URL gets /<country> appended
PROVIDER_BASE_URL=http://localhost:8001
PROVIDER_TIMEOUT_SECONDS=5
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_BASE_SECONDS=0.5

# Per-country overrides: PROVIDER_<COUNTRY>_<SETTING>
PROVIDER_AR_TIMEOUT_SECONDS=3
PROVIDER_AR_MAX_RETRIES=5
PROVIDER_AR_BACKOFF_BASE_SECONDS=1
# PROVIDER_AR_BASE_URL=http://localhost:8001/ar

# Mock providers: relative weights for random scenarios (X-Mock-Scenario header overrides)
MOCK_SUCCESS_WEIGHT=80
MOCK_ERROR_WEIGHT=10
MOCK_TIMEOUT_WEIGHT=5
MOCK_REJECT_WEIGHT=5
MOCK_TIMEOUT_SECONDS=30
